{
  "name": "hireprep-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --mode lan-https",
    "dev:full": "set -a; . ./.env.local 2>/dev/null; set +a; node scripts/dev-full.mjs",
    "dev:vercel": "set -a; . ./.env.local 2>/dev/null; set +a; npx --yes vercel@56 dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:bundle": "npm run build && node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@supabase/supabase-js": "^2.117.3",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vercel/node": "^5.8.26",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.6"
  }
}
